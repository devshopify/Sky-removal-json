# Shopify 凭据（本地用，勿提交）。复制成 .env.videos 再填。
#
# 2026-01-01 之后新建的应用都在 Dev Dashboard，没有可直接复制的静态 token，
# 而是用 Client ID + Client secret 现换（脚本自动换，24 小时过期不影响使用）。
# 一份凭据可以覆盖同一组织下的多个店铺 —— 只要 app 已安装到那些店。

# ---- Dev Dashboard 应用（推荐） ----
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# myshopify 子域名，逗号分隔。不是自定义域名！
# 看后台地址栏 admin.shopify.com/store/<handle>，或 设置 → 域名
SHOPIFY_SHOPS=dreame-global

# ---- legacy 应用（2026-01-01 前创建，仍可用静态 token） ----
# SHOPIFY_SHOP=dreame-global.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：默认输出到 data/downloads
# SHOPIFY_OUT=./data/downloads

# 可选：OAuth 授权时的回调地址，要和 app 里 Allowed redirection URLs 一致
# SHOPIFY_REDIRECT_URI=http://localhost
